model Reservation {
    id          String            @id @default(cuid(2))
    name        String
    phoneNumber String
    note        String?
    status      ReservationStatus @default(BOOKED)

    people           Person[]
    reservationItems ReservationItem[]

    startDate DateTime
    endDate   DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Person {
    id     String  @id @default(cuid(2))
    name   String
    weight Int
    height Int
    age    Int
    gender Gender
    level  Level?
    note   String?

    status PersonStatus @default(ACTIVE)

    poles          Int?
    backProtection Boolean @default(false)
    skiCover       Boolean @default(false)
    bootCover      Boolean @default(false)
    goggles        Goggle?

    reservationId String
    reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

    reservationItems ReservationItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ReservationItem {
    id        String                @id @default(cuid(2))
    startDate DateTime
    endDate   DateTime
    status    ReservationItemStatus @default(ACTIVE)

    reservationId String
    reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

    personId String?
    person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

    equipmentItemId String
    equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([equipmentItemId])
    @@index([reservationId])
    @@index([personId])
}

model EquipmentItem {
    id   String            @id @default(cuid(2))
    type EquipmentItemType

    /// Sticker prefix — the whole mondopoint size for boots, null for the types
    articleGroup  Int?
    /// Sequence within (type, articleGroup). The `86` in the sticker `26.86`.
    articleNumber Int

    retiredAt DateTime?

    /// When this item was last physically seen during a stock check (inventura).
    /// Null = never checked. Compared against the current season start, not a
    /// rolling 12 months — see `seasonStart()` in apps/api/src/schemas/stockCheck.ts.
    lastCheckedAt DateTime?

    ski           Ski?
    snowboard     Snowboard?
    helmet        Helmet?
    skiBoot       SkiBoot?
    snowboardBoot SnowboardBoot?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    reservationItems ReservationItem[]

    /// No two live items share a number. Partial, so retiring an item releases
    /// its number for reuse — a retired 26.2 and a live 26.2 can coexist.
    ///
    /// The migration adds `NULLS NOT DISTINCT` to this index by hand. Prisma
    /// can't express it and can't see it, so it won't fight you over it — but it
    /// won't recreate it either. Without it the index would be inert for skis,
    /// snowboards and helmets, whose `articleGroup` is null: SQL treats null as
    /// never equal to itself, so every row would look unique. Keep the modifier
    /// on any future migration that rebuilds this index, and don't use
    /// `db push`, which skips migrations entirely.
    @@unique([type, articleGroup, articleNumber], where: raw("\"retiredAt\" IS NULL"), map: "EquipmentItem_live_article_key")
}

enum EquipmentItemType {
    SKI
    SKI_BOOT
    SNOWBOARD
    SNOWBOARD_BOOT
    HELMET
}

enum Gender {
    MALE
    FEMALE
}

enum ReservationStatus {
    BOOKED
    PICKED_UP
    RETURNED
    CANCELLED
}

enum PersonStatus {
    ACTIVE
    CANCELLED
}

enum ReservationItemStatus {
    ACTIVE
    CANCELLED
}

enum Level {
    BEGINNER
    BEGINNER_INTERMEDIATE
    INTERMEDIATE
    INTERMEDIATE_EXPERT
    EXPERT
}

enum Goggle {
    MALE
    FEMALE
    JUNIOR
}

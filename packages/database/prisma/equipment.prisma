model Ski {
  id     String @id @default(cuid(2))
  brand  String
  model  String?
  length Int

  isOld  Boolean @default(false)
  isVIP  Boolean @default(false)
  isKids Boolean @default(false)
  // null = unisex, which is most of the stock. Only the gear actually styled
  gender Gender?

  equipmentItemId String        @unique
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Snowboard {
  id     String @id @default(cuid(2))
  brand  String
  model  String?
  length Int

  // null = unisex. See `Ski.gender`.
  gender Gender?

  equipmentItemId String        @unique
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Helmet {
  id                    String        @id @default(cuid(2))
  brand                 String
  model                 String?
  size                  HelmetSize?

  // Head circumference in whole cm
  // Fixed size (XL): circumferenceMin === circumferenceMax
  // ADJUSTABLE: circumferenceMin < circumferenceMax
  circumferenceMin      Int?
  circumferenceMax      Int?
  color                 String
  description           String?
  withIntegratedGoggles Boolean       @default(false)
  // null = unisex.
  gender                Gender?
  equipmentItemId       String        @unique
  equipmentItem         EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkiBoot {
  id    String @id @default(cuid(2))
  brand String
  model String?
  color String?

  // Mondopoint, in half-size steps — a 26.5 is a real boot. `Float`, not
  // `Decimal`: halves are exact in binary floating point, so equality and
  // sorting are exact too, and the value reaches the client as a plain number
  // instead of a `Decimal` object superjson would have to be taught.
  // Which sticker pool it lands in is `articleGroup`, not this column.
  length Float

  isKids Boolean @default(false)
  // null = unisex. See `Ski.gender`.
  gender Gender?

  equipmentItemId String        @unique
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SnowboardBoot {
  id    String @id @default(cuid(2))
  brand String
  model String?

  // Mondopoint in half-size steps. See `SkiBoot.length`.
  length Float

  isBoa  Boolean @default(false)
  isKids Boolean @default(false)
  // null = unisex. See `Ski.gender`.
  gender Gender?

  equipmentItemId String        @unique
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HelmetSize {
  XS
  S
  M
  L
  XL
  ADJUSTABLE
}

{
	"$schema": "https://v2-10-4.turborepo.dev/schema.json",
	"envMode": "loose",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "^db:generate"],
			"outputs": ["dist/**", "build/**"],
			"inputs": ["src/**", "generated/**", "package.json", "tsconfig.json"],
			"env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "COOKIE_DOMAIN", "PORT", "API_URL", "WEB_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "COOKIE_DOMAIN", "PORT", "API_URL", "WEB_URL"]
		},
		"check-types": {
			"dependsOn": ["^check-types", "^db:generate"]
		},
		"db:generate": {
			"dependsOn": ["^db:generate"],
			"outputs": ["generated/**"],
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:deploy": {
			"cache": false
		},
		"db:seed": {
			"dependsOn": ["^db:generate"],
			"cache": false
		},
		"db:studio": {
			"cache": false
		}
	}
}

# API env
APP_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:5174

BETTER_AUTH_SECRET=some_secret

# Production only. Registrable domain shared by the api/web subdomains, so the
# session cookie set by api.<domain> is accepted alongside rent.<domain>.
# Leave unset locally. Must not be a public suffix (e.g. .up.railway.app).
# COOKIE_DOMAIN=.railtest-app.fun

# Railway sets this; it arms better-auth's default-secret guard.
# NODE_ENV=production

# WEB env
VITE_API_URL=http://localhost:3001
APP_PORT=5174

# Shared env
DATABASE_URL="postgresql://postgres:password@localhost:5433/ski-blazek?schema=public"